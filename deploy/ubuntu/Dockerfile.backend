FROM node:22-bookworm-slim AS javascript

FROM python:3.12-slim-bookworm
ARG PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

RUN (sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list) \
    && apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates libatomic1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
COPY deploy/ubuntu/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --timeout 180 --retries 5 \
    --index-url "$PIP_INDEX_URL" -r /tmp/requirements.txt

RUN groupadd --gid 10001 v2a \
    && useradd --uid 10001 --gid 10001 --no-create-home v2a \
    && mkdir -p /data/snapshots \
    && chown -R 10001:10001 /data
COPY backend /app
WORKDIR /data
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--app-dir", "/app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
